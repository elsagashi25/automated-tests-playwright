# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In CI, set these as masked/protected CI variables instead.
# ---------------------------------------------------------------

# Which project profile to load from ./projects/<PROJECT>.ts
PROJECT=demo

# Storefront base URL (overrides the value in the project profile)
BASE_URL=https://automated-testing.development-s25.com

# Optional HTTP basic auth (staging environments behind .htaccess)
HTTP_USERNAME=
HTTP_PASSWORD=

# --- Admin API (used for test data setup + cleanup) --------------
# Preferred for CI: an integration (Settings > System > Integrations)
ADMIN_CLIENT_ID=
ADMIN_CLIENT_SECRET=
# Alternative: an admin user (password grant)
# NOTE: wrap values containing # or spaces in quotes, e.g. ADMIN_PASSWORD="abc#123"
#       (unquoted, everything after # is treated as a comment)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Store API ---------------------------------------------------
# Sales channel access key. If empty, it is resolved automatically via
# the Admin API by matching BASE_URL against the sales channel domains.
SW_ACCESS_KEY=

# --- Safety switches ---------------------------------------------
# Set to false for production-like environments: skips tests that
# create customers, place orders or submit forms.
ALLOW_WRITE_TESTS=true
# Delete customers created by the tests afterwards (needs Admin API)
CLEANUP_TEST_DATA=true

# Browsers to run in addition to chromium + firefox + mobile: webkit
EXTRA_BROWSERS=

# Use an installed browser instead of Playwright's Chromium download (chromium + mobile
# projects), e.g. chrome or msedge — handy when the Playwright CDN is blocked
PW_CHANNEL=
